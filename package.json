{
  "name": "cc-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code plugin and memory distillation CLI runner",
  "scripts": {
    "dev": "go run main.go",
    "test": "go test ./...",
    "build": "go build -o bin/cc-plugin .",
    "deploy": "go install .",
    "lint": "gofmt -l . && go vet ./... && shellcheck pkg/hermes/scripts/*.sh",
    "clean": "rm -rf bin",
    "destroy": "pkill -f 'bin/cc-plugin' || true",
    "ci": "npm run lint && npm run test && npm run build",
    "run:setup": "./scripts/run.sh",
    "run:distill": "go run main.go distill",
    "run:export-claudemem": "go run main.go export claudemem",
    "run:topology-verify": "go run main.go topology verify",
    "hermes:install": "./pkg/hermes/scripts/setup.sh",
    "hermes:upgrade": "./pkg/hermes/scripts/setup.sh --upgrade",
    "hermes:install:webui": "./pkg/hermes/scripts/setup-webui.sh",
    "hermes:upgrade:webui": "./pkg/hermes/scripts/setup-webui.sh --upgrade",
    "hermes:setup": "./pkg/hermes/scripts/run.sh",
    "hermes:persona": "f() { HERMES_PERSONA=\"$1\" ./pkg/hermes/scripts/run.sh; }; f",
    "hermes:webui": "\"${HERMES_HOME:-$HOME/.hermes}/hermes-webui/ctl.sh\""
  }
}
