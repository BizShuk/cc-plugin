{
  "name": "cc-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code plugin and memory distillation CLI runner",
  "scripts": {
    "setup": "./run.sh",
    "dev": "npx npm-run-all --parallel dev:*",
    "dev:cli": "go run main.go",
    "test": "npx npm-run-all --parallel test:*",
    "test:cli": "go test ./...",
    "lint": "npx npm-run-all --parallel lint:*",
    "lint:cli": "go vet ./...",
    "build": "npx npm-run-all --parallel build:*",
    "build:cli": "go build -o bin/cc-plugin .",
    "deploy": "npx npm-run-all --parallel deploy:*",
    "deploy:cli": "go install ."
  }
}
