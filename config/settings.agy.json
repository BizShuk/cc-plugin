{
  "model": "Gemini 3.8 Flash (High)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(agy*)",
      "command(cat *)",
      "command(cp *)",
      "command(diff *)",
      "command(echo *)",
      "command(git *)",
      "command(ln *)",
      "command(mkdir *)",
      "command(npx *)",
      "command(rm *)",
      "command(sed *)",
      "command(strings *)",
      "command(which *)",
      "command(/home/shuk/.bun/bin/ccstatusline*)",
      "command(/Users/shuk/.bun/bin/ccstatusline*)",
      "command(~/.bun/bin/ccstatusline*)",
      "command(/home/shuk/.local/bin/agy-statusline*)",
      "command(/Users/shuk/.local/bin/agy-statusline*)",
      "command(~/.local/bin/agy-statusline*)",
      "command(/tmp/*.sh*)"
    ]
  },
  "runningLightSpeed": "fast",
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/agy-statusline",
    "enabled": true
  },
  "trustedWorkspaces": [
    "/home/shuk",
    "/Users/shuk"
  ]
